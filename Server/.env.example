# PayMongo (https://dashboard.paymongo.com) — enables GCash checkout
PAYMONGO_SECRET_KEY=your_paymongo_secret_key

# Stripe (https://dashboard.stripe.com) — enables Credit/Debit Card checkout
STRIPE_SECRET_KEY=your_stripe_secret_key
# Optional: currency code for Stripe (defaults to php). Minimum PHP charge on Stripe is 50.00.
STRIPE_CURRENCY=php
# Optional: webhook signing secret for Stripe webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=FMG Catering <your_email@gmail.com>

# Database Configuration
DB_TYPE=sqlite
# Turso (hosted libSQL / SQLite) — used for Vercel deployment
# TURSO_URL=libsql://your-db-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...
# PostgreSQL settings (for future migration to Supabase)
# PG_HOST=your_supabase_host
# PG_PORT=5432
# PG_DATABASE=your_database_name
# PG_USER=your_database_user
# PG_PASSWORD=your_database_password

# Security
JWT_SECRET=generate_with_node_crypto_randomBytes_32_hex

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Docs / Drive integration — uploads the monthly summary report as a
# Word document (.docx) to Google Drive, converts it to a Google Doc, and shares
# it with the admin email automatically.
#
# Two auth options (use ONE of them):
#
# Option A — OAuth (personal Google/Gmail account, recommended & simplest).
#   Setup: create an OAuth Client ID (API & Services > Credentials > OAuth
#   client ID > Web application), set the redirect URI to
#   https://fmg-catering-server.vercel.app/api/reports/google-docs/auth/callback
#   then run the "Connect Google Account" button in the Reports tab. It shows
#   a refresh token — store it here.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_1time_refresh_token
#
# Option B — Service account (blocked for some orgs by iam.disableServiceAccountKeyCreation).
#   Setup: Google Cloud → enable "Google Drive API" → create a Service Account →
#   download its JSON key. Then either set the two vars below, or paste the whole
#   JSON in GOOGLE_APPLICATION_CREDENTIALS_JSON.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@yourproject.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFA...\n-----END PRIVATE KEY-----\n
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# GOOGLE_DRIVE_FOLDER_ID=optional_folder_id_where_the_doc_is_created
GOOGLE_DRIVE_SHARE_EMAIL=admin@gmail.com

# Server
PORT=3001
CLIENT_URL=http://localhost:5173
